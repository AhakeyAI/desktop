<Window x:Class="AhaKey.Studio.Views.DisplayOverwriteWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Width="620" SizeToContent="Height" MinWidth="500" MaxHeight="720" WindowStartupLocation="CenterOwner" Background="{DynamicResource Surface}" Title="AhaKey Studio · Display">
 <Border Background="{DynamicResource Surface}" Padding="24" TextElement.Foreground="{DynamicResource TextPrimary}"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <TextBlock Text="{Binding L[DisplayOverwriteTitle]}" Style="{StaticResource PageTitle}"/>
  <TextBlock Grid.Row="1" Text="{Binding L[DisplayOverwriteWarning]}" Style="{StaticResource Secondary}" Margin="0,12,0,20"/>
  <Expander Grid.Row="2" Header="{Binding L[Advanced]}" Foreground="{DynamicResource TextPrimary}"><ScrollViewer MaxHeight="320" VerticalScrollBarVisibility="Auto"><TextBox Text="{Binding Details,Mode=OneWay}" IsReadOnly="True" TextWrapping="Wrap" Style="{StaticResource TechnicalText}" AutomationProperties.Name="{Binding L[DisplayPlanDetails]}"/></ScrollViewer></Expander>
  <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0"><Button Content="{Binding L[Cancel]}" IsCancel="True" Margin="0,0,12,0"/><Button Content="{Binding L[DisplayConfirmOverwrite]}" Style="{StaticResource PrimaryButton}" Click="Accept"/></StackPanel>
 </Grid></Border>
</Window>
