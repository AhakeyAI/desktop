<UserControl x:Class="AhaKey.Studio.Views.DisplayPlannerPage" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
 <StackPanel>
  <TextBlock Text="{Binding L[Display]}" Style="{StaticResource PageTitle}"/>
  <TextBlock Text="{Binding L[DisplayPlannerIntro]}" Style="{StaticResource Secondary}" Margin="0,8,0,24"/>
  <TextBlock Text="{Binding L[TargetState]}" Style="{StaticResource Caption}" Margin="0,0,0,8"/>
  <WrapPanel><ComboBox ItemsSource="{Binding Assets}" DisplayMemberPath="Label" SelectedItem="{Binding Asset}" MinWidth="180" Margin="0,0,12,12" AutomationProperties.Name="{Binding L[Display]}"/><Button Content="{Binding L[DisplayImport]}" Command="{Binding ImportCommand}" Margin="0,0,12,12"/></WrapPanel>
  <WrapPanel><ComboBox ItemsSource="{Binding FitModes}" DisplayMemberPath="Label" SelectedItem="{Binding Fit}" MinWidth="180" Margin="0,0,12,12" AutomationProperties.Name="{Binding L[DisplayFitMode]}"/><Button Content="{Binding L[DisplayConvert]}" Command="{Binding ConvertCommand}" Margin="0,0,0,12"/></WrapPanel>
  <Grid Margin="0,0,0,16"><Grid.ColumnDefinitions><ColumnDefinition Width="340"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><StackPanel>  <TextBlock Text="{Binding L[DisplayConvertedHint]}" Style="{StaticResource Caption}"/>
  <Border Background="Black" Width="320" Height="160" HorizontalAlignment="Left" Margin="0,8,0,16"><Image Source="{Binding Preview}" Stretch="Fill" RenderOptions.BitmapScalingMode="NearestNeighbor" AutomationProperties.Name="{Binding L[DisplayPreview]}"/></Border>
  <TextBlock Text="{Binding CapacityText}" Style="{StaticResource Caption}"/><TextBlock Text="{Binding SourceTiming}" Style="{StaticResource Caption}"/><TextBlock Text="{Binding Duration}" Style="{StaticResource Caption}"/>
  <TextBlock Text="{Binding Source}" ToolTip="{Binding Source}" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" Style="{StaticResource SectionTitle}"/>
</StackPanel><StackPanel Grid.Column="1" Margin="12,0,0,0">  <Button Style="{StaticResource PrimaryButton}" Content="{Binding UploadLabel}" Command="{Binding UploadCommand}" HorizontalAlignment="Left"/>
  <TextBlock Text="{Binding UploadScope}" Style="{StaticResource Secondary}" Margin="0,8,0,0"/>
  <TextBlock Text="{Binding UploadResult}" Style="{StaticResource Secondary}" Margin="0,8,0,0" AutomationProperties.LiveSetting="Polite"/>
  <TextBlock Text="{Binding Progress}" Style="{StaticResource Secondary}" Margin="0,8,0,0" AutomationProperties.LiveSetting="Polite"/>
  <TextBlock Text="{Binding Availability}" Style="{StaticResource Secondary}" Margin="0,8,0,16"/>
</StackPanel></Grid>
  <Expander Header="{Binding L[DisplayAnimationEditor]}" Foreground="{DynamicResource TextPrimary}" Margin="0,0,0,20"><StackPanel>  <WrapPanel Margin="0,12,0,0"><StackPanel Margin="0,0,12,12"><TextBlock Text="{Binding L[DisplayBackground]}" Style="{StaticResource Caption}"/><TextBox Text="{Binding Background,UpdateSourceTrigger=LostFocus}" MaxLength="7" MinWidth="110" AutomationProperties.Name="{Binding L[DisplayBackground]}"/></StackPanel><StackPanel Margin="0,0,12,12"><TextBlock Text="{Binding L[DisplayInterval]}" Style="{StaticResource Caption}"/><TextBox Text="{Binding IntervalMs,UpdateSourceTrigger=LostFocus}" MinWidth="110" AutomationProperties.Name="{Binding L[DisplayInterval]}"/></StackPanel><StackPanel><TextBlock Text="{Binding L[DisplayFrame]}" Style="{StaticResource Caption}"/><ComboBox ItemsSource="{Binding Frames}" SelectedItem="{Binding SelectedFrame}" MinWidth="90" AutomationProperties.Name="{Binding L[DisplayFrame]}"/></StackPanel></WrapPanel>
  <WrapPanel><Button Content="{Binding L[DisplayFrameEarlier]}" Command="{Binding FrameEarlierCommand}" Margin="0,0,8,8"/><Button Content="{Binding L[DisplayFrameLater]}" Command="{Binding FrameLaterCommand}" Margin="0,0,0,8"/></WrapPanel>
  <TextBlock Text="{Binding FrameOrderText}" Style="{StaticResource Caption}"/><TextBlock Text="{Binding TimingNotice}" Style="{StaticResource Secondary}"/><TextBlock Text="{Binding Duration}" Style="{StaticResource Caption}"/>
  <TextBlock Text="{Binding Status}" Style="{StaticResource Secondary}" Margin="0,8,0,24" AutomationProperties.LiveSetting="Polite"/>
</StackPanel></Expander>
  <TextBlock Text="{Binding L[DisplayLibrary]}" Style="{StaticResource SectionTitle}" Margin="0,0,0,8"/>
  <ComboBox ItemsSource="{Binding Library}" SelectedItem="{Binding SelectedProject}" AutomationProperties.Name="{Binding L[DisplayLibrary]}" Margin="0,0,0,8"><ComboBox.ItemTemplate><DataTemplate><StackPanel><TextBlock Text="{Binding Name}"/><TextBlock Text="{Binding LibraryDetail}" Style="{StaticResource Caption}"/><TextBlock Text="{Binding ModifiedText}" Style="{StaticResource Caption}"/></StackPanel></DataTemplate></ComboBox.ItemTemplate></ComboBox>
  <WrapPanel><Button Content="{Binding L[Open]}" Command="{Binding OpenProjectCommand}" Margin="0,0,8,12"/><Button Content="{Binding L[Duplicate]}" Command="{Binding DuplicateProjectCommand}" Margin="0,0,8,12"/><Button Content="{Binding L[Rename]}" Command="{Binding RenameProjectCommand}" Margin="0,0,8,12"/></WrapPanel>
  <WrapPanel><TextBox Text="{Binding ProjectName,UpdateSourceTrigger=PropertyChanged}" MinWidth="180" MaxLength="80" AutomationProperties.Name="{Binding L[DisplayProjectName]}" Margin="0,0,8,12"/><Button Content="{Binding L[DisplaySaveProject]}" Command="{Binding SaveProjectCommand}" Margin="0,0,8,12"/><Button Content="{Binding L[DisplayRemoveProject]}" Command="{Binding DeleteProjectCommand}" Margin="0,0,0,12"/></WrapPanel>
  <Expander Header="{Binding L[Advanced]}" Foreground="{DynamicResource TextPrimary}"><StackPanel><TextBlock Text="{Binding OperationDetail}" Style="{StaticResource Secondary}" Margin="0,8,0,0"/><Button Content="{Binding L[DisplayExportPlan]}" Command="{Binding ExportCommand}" HorizontalAlignment="Left" Margin="0,12,0,0"/><TextBox Text="{Binding PlanText,Mode=OneWay}" IsReadOnly="True" TextWrapping="Wrap" Style="{StaticResource TechnicalText}" Margin="0,12,0,0" AutomationProperties.Name="{Binding L[DisplayPlanDetails]}"/></StackPanel></Expander>
 </StackPanel>
</UserControl>
