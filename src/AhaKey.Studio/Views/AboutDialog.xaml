<Window x:Class="AhaKey.Studio.Views.AboutDialog" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="{Binding L[About]}" Width="560" SizeToContent="Height" ResizeMode="NoResize" WindowStartupLocation="CenterOwner" Background="{DynamicResource Surface}" Foreground="{DynamicResource TextPrimary}" FontFamily="Segoe UI" FontSize="{StaticResource Type.Body.Size}"><Border Background="{DynamicResource Surface}" Padding="32"><StackPanel><Image Source="/Assets/AhaKeyStudio.png" Width="48" Height="48" HorizontalAlignment="Left" Margin="0,0,0,16"/><TextBlock Text="{Binding L[About]}" Style="{StaticResource SectionTitle}"/><TextBlock Text="{Binding Version.SupportText}" Style="{StaticResource SecondaryText}"/><Button Content="{Binding L[Close]}" Click="CloseDialog" IsCancel="True" IsDefault="True" HorizontalAlignment="Right" Margin="0,24,0,0"/></StackPanel></Border></Window>