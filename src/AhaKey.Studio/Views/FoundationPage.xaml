<UserControl x:Class="AhaKey.Studio.Views.FoundationPage" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:controls="clr-namespace:AhaKey.Studio.Controls">
 <StackPanel><TextBlock Text="{Binding PageTitle}" Style="{StaticResource PageTitle}"/><TextBlock Text="{Binding PageHint}" Style="{StaticResource SecondaryText}" Margin="0,8,0,24"/>
  <StackPanel Visibility="{Binding IsDisplay, Converter={StaticResource BoolVisibility}}" Margin="0,0,0,16"><ItemsControl ItemsSource="{Binding DisplayStates}" Margin="-8,0,-8,0"><ItemsControl.ItemsPanel><ItemsPanelTemplate><UniformGrid Columns="2"/></ItemsPanelTemplate></ItemsControl.ItemsPanel><ItemsControl.ItemTemplate><DataTemplate><controls:DisplayPreview StateTitle="{Binding Name}" CurrentFrames="{Binding CurrentFrames}" MaximumFrames="{Binding MaximumFrames}" SourceName="{Binding SourceName}" Margin="8,0,8,16"/></DataTemplate></ItemsControl.ItemTemplate></ItemsControl><TextBlock Text="{Binding L[DisplayPreviewOnly]}" Style="{StaticResource Caption}"/></StackPanel>
  <StackPanel Visibility="{Binding IsLighting, Converter={StaticResource BoolVisibility}}" Margin="0,0,0,24"><TextBlock Text="{Binding L[GlobalBrightness]}" Style="{StaticResource SectionTitle}"/><TextBlock Text="{Binding L[BrightnessHint]}" Style="{StaticResource SecondaryText}"/><Grid Margin="0,24,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="64"/></Grid.ColumnDefinitions><Slider Minimum="1" Maximum="100" Value="{Binding Brightness}" TickFrequency="1" IsSnapToTickEnabled="True" IsEnabled="{Binding CanUseMock}" AutomationProperties.Name="{Binding L[GlobalBrightness]}"/><TextBlock Grid.Column="1" Text="{Binding Brightness}" Style="{StaticResource CardTitle}" HorizontalAlignment="Right"/></Grid></StackPanel>
  <StackPanel Visibility="{Binding IsDevice, Converter={StaticResource BoolVisibility}}" Margin="0,0,0,24"><controls:DevicePreview MaxWidth="640" HorizontalAlignment="Left" Margin="0,0,0,16"/><TextBlock Text="{Binding L[SimulationNotice]}" Foreground="{DynamicResource Warning}"/><WrapPanel Margin="0,24,0,0"><Button Content="{Binding L[Connect]}" Command="{Binding ConnectCommand}" IsEnabled="{Binding CanConnect}" Margin="0,0,12,12"/><Button Content="{Binding L[Disconnect]}" Command="{Binding DisconnectCommand}" IsEnabled="{Binding CanDisconnect}" Margin="0,0,12,12"/><Button Content="{Binding L[Read]}" Command="{Binding ReadCommand}" IsEnabled="{Binding CanWrite}" Margin="0,0,12,12"/></WrapPanel></StackPanel>
  <StackPanel Visibility="{Binding IsDiagnostics, Converter={StaticResource BoolVisibility}}" Margin="0,0,0,24">
   <WrapPanel><Button Content="{Binding L[Connect]}" Command="{Binding ConnectCommand}" IsEnabled="{Binding CanConnect}" Margin="0,0,12,12"/><Button Content="{Binding L[Disconnect]}" Command="{Binding DisconnectCommand}" IsEnabled="{Binding CanDisconnect}" Margin="0,0,12,12"/><Button Content="{Binding L[Read]}" Command="{Binding ReadCommand}" IsEnabled="{Binding CanWrite}" Margin="0,0,12,12"/></WrapPanel>
   <TextBlock Text="{Binding L[FailureScenario]}" FontWeight="SemiBold" Margin="0,12,0,8"/><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><ComboBox ItemsSource="{Binding Failures}" SelectedItem="{Binding Failure}" DisplayMemberPath="Label" AutomationProperties.Name="{Binding L[FailureScenario]}"/><Button Grid.Column="1" Content="{Binding L[ArmFailure]}" Command="{Binding ArmFailureCommand}" IsEnabled="{Binding CanUseMock}" Margin="12,0,0,0"/></Grid><TextBlock Text="{Binding NoticeText}" Foreground="{DynamicResource Focus}" Margin="0,8,0,0"/>
   <TextBlock Text="{Binding L[Confirmation]}" FontWeight="SemiBold" Margin="0,24,0,8"/><ComboBox ItemsSource="{Binding Switches}" SelectedItem="{Binding Confirmation}" DisplayMemberPath="Label" IsEnabled="{Binding CanUseMock}" AutomationProperties.Name="{Binding L[Confirmation]}"/><TextBlock Text="{Binding L[SwitchHint]}" Style="{StaticResource SecondaryText}" Margin="0,8,0,0"/>
   <TextBlock Text="{Binding L[Telemetry]}" FontWeight="SemiBold" Margin="0,24,0,8"/><Slider Minimum="0" Maximum="100" Value="{Binding SimulatedBattery}" TickFrequency="1" IsSnapToTickEnabled="True" IsEnabled="{Binding CanUseMock}" AutomationProperties.Name="{Binding L[Telemetry]}"/>
   <TextBlock Text="{Binding L[Evidence]}" Style="{StaticResource SectionTitle}" Margin="0,24,0,12"/><TextBlock Text="{Binding L[ReadEvidence]}" Style="{StaticResource SecondaryText}"/><TextBlock Text="{Binding ReadEvidence}" Margin="0,4,0,12"/><TextBlock Text="{Binding L[WriteEvidence]}" Style="{StaticResource SecondaryText}"/><TextBlock Text="{Binding WriteEvidence}" Margin="0,4,0,12"/>
   <TextBlock Text="{Binding L[Logs]}" Style="{StaticResource SectionTitle}" Margin="0,16,0,8"/><TextBlock Text="{Binding L[ClearLogsHint]}" Style="{StaticResource SecondaryText}" Margin="0,0,0,8"/><TextBox Text="{Binding LogText, Mode=OneWay}" IsReadOnly="True" TextWrapping="Wrap" MaxHeight="192" VerticalScrollBarVisibility="Auto" Style="{StaticResource TechnicalText}" AutomationProperties.Name="{Binding L[Logs]}"/>
  </StackPanel>
  <Border BorderBrush="{DynamicResource Border}" BorderThickness="0,1,0,0" Padding="0,16,0,0"><TextBlock Text="{Binding L[FuturePhase]}" Style="{StaticResource SecondaryText}"/></Border>
 </StackPanel>
</UserControl>