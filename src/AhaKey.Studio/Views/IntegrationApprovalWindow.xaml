<Window x:Class="AhaKey.Studio.Views.IntegrationApprovalWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="{Binding L[IntegrationPermission]}" Width="480" SizeToContent="Height" ResizeMode="NoResize" WindowStartupLocation="CenterOwner" Background="{DynamicResource Surface}" Foreground="{DynamicResource TextPrimary}" FontFamily="Segoe UI">
 <Border Background="{DynamicResource Surface}" Padding="24"><StackPanel><TextBlock Text="{Binding L[IntegrationPermission]}" Style="{StaticResource SectionTitle}"/><TextBlock Text="{Binding ContextText}" Margin="0,12,0,12"/><TextBlock Text="{Binding L[IntegrationApprovalHint]}" Style="{StaticResource SecondaryText}"/><StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,24,0,0"><Button Content="{Binding L[IntegrationDeny]}" Click="Deny" IsCancel="True" Margin="0,0,12,0"/><Button Content="{Binding L[IntegrationAllow]}" Click="Allow"/></StackPanel></StackPanel></Border>
</Window>
