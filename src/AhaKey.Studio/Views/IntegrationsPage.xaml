<UserControl x:Class="AhaKey.Studio.Views.IntegrationsPage" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
 <StackPanel>
  <TextBlock Text="{Binding L[Integrations]}" Style="{StaticResource PageTitle}"/>
  <TextBlock Text="{Binding L[IntegrationIntro]}" Style="{StaticResource SecondaryText}" Margin="0,8,0,20"/>
  <CheckBox Content="{Binding L[ProductServiceAutoStart]}" IsChecked="{Binding AutoStart}" Margin="0,0,0,16"/>
  <WrapPanel Margin="0,0,0,12">
   <Button Content="{Binding L[IntegrationRefresh]}" Command="{Binding RefreshCommand}" Margin="0,0,12,8"/>
   <TextBlock Text="{Binding ServiceText}" Style="{StaticResource Body}" VerticalAlignment="Center" Margin="0,0,0,8"/>
  </WrapPanel>
  <TextBlock Text="{Binding ErrorText}" Foreground="{DynamicResource Danger}" Visibility="{Binding HasError,Converter={StaticResource BoolVisibility}}" Margin="0,0,0,12" AutomationProperties.LiveSetting="Polite"/>
  <ListBox ItemsSource="{Binding Rows}" SelectedItem="{Binding Selected}" AutomationProperties.Name="{Binding L[Integrations]}" AutomationProperties.AutomationId="IntegrationList" ScrollViewer.HorizontalScrollBarVisibility="Disabled" ScrollViewer.VerticalScrollBarVisibility="Disabled" ScrollViewer.CanContentScroll="False">
   <ListBox.ItemContainerStyle><Style TargetType="ListBoxItem" BasedOn="{StaticResource {x:Type ListBoxItem}}"><Setter Property="HorizontalContentAlignment" Value="Stretch"/><Setter Property="Padding" Value="12"/><Setter Property="Margin" Value="0,0,0,8"/></Style></ListBox.ItemContainerStyle>
   <ListBox.ItemTemplate><DataTemplate><StackPanel>
    <DockPanel><WrapPanel DockPanel.Dock="Right"><Button Content="{Binding PrimaryLabel}" Command="{Binding DataContext.PrimaryCommand,RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding Id}" Visibility="{Binding HasPrimary,Converter={StaticResource BoolVisibility}}" Click="PrimaryClicked" Margin="12,0,0,8"/><Button Content="{Binding DataContext.L[IntegrationDetails],RelativeSource={RelativeSource AncestorType=UserControl}}" Command="{Binding DataContext.DetailsCommand,RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding Id}" Click="DetailsClicked" Margin="12,0,0,8"/><Button Content="{Binding DataContext.L[IntegrationMaintenance],RelativeSource={RelativeSource AncestorType=UserControl}}" Click="MaintenanceClicked" Margin="12,0,0,8"/></WrapPanel><WrapPanel><TextBlock Text="{Binding Name}" Style="{StaticResource CardTitle}" Margin="0,0,16,4"/><TextBlock Text="{Binding Version}" Style="{StaticResource SecondaryText}" VerticalAlignment="Center" Margin="0,0,0,4"/></WrapPanel></DockPanel>
    <WrapPanel><TextBlock Text="{Binding Readiness}" Style="{StaticResource Body}" FontWeight="SemiBold" Margin="0,0,16,8"/><TextBlock Text="{Binding Service}" Margin="0,0,16,8"/><TextBlock Text="{Binding Feedback}" Margin="0,0,0,8"/></WrapPanel>
    <WrapPanel><TextBlock Text="{Binding Activity}" Style="{StaticResource SecondaryText}" Margin="0,0,16,0"/><TextBlock Text="{Binding LastActivity}" Style="{StaticResource SecondaryText}"/></WrapPanel>
   </StackPanel></DataTemplate></ListBox.ItemTemplate>
  </ListBox>
  <StackPanel x:Name="DetailsSection" Visibility="{Binding HasSelection,Converter={StaticResource BoolVisibility}}" Margin="0,24,0,0">
   <DockPanel><Button x:Name="DetailsBack" Click="BackClicked" Content="{Binding L[IntegrationBack]}" Command="{Binding BackCommand}" DockPanel.Dock="Right"/><TextBlock Text="{Binding Selected.Name}" Style="{StaticResource SectionTitle}"/></DockPanel>
    <WrapPanel><TextBlock Text="{Binding Selected.Installed}" Margin="0,0,16,4"/><TextBlock Text="{Binding Selected.Configured}" Margin="0,0,16,4"/><TextBlock Text="{Binding Selected.Enabled}" Margin="0,0,16,4"/><TextBlock Text="{Binding Selected.Trusted}" Margin="0,0,16,4"/><TextBlock Text="{Binding Selected.Compatible}" Margin="0,0,16,4"/></WrapPanel>
   <TextBlock Text="{Binding Selected.Error}" Foreground="{DynamicResource Danger}" Margin="0,8,0,0"/>
   <TextBlock Text="{Binding L[IntegrationConfigFiles]}" Style="{StaticResource SecondaryText}" Margin="0,12,0,4"/>
   <TextBox x:Name="DetailsConfigPath" Text="{Binding Selected.ConfigPath,Mode=OneWay}" IsReadOnly="True" Style="{StaticResource TechnicalText}" TextWrapping="Wrap"/>
   <TextBlock Text="{Binding L[IntegrationLastEvent]}" Style="{StaticResource SecondaryText}" Margin="0,12,0,4"/>
   <TextBlock Text="{Binding Selected.LastEvent}"/>
   <TextBlock Text="{Binding L[IntegrationTrustHint]}" Style="{StaticResource SecondaryText}" Margin="0,12,0,12"/>
   <WrapPanel Visibility="{Binding CanConfigure,Converter={StaticResource BoolVisibility}}"><Button x:Name="DetailsInstall" Content="{Binding L[IntegrationConfigure]}" Command="{Binding PrepareCommand}" CommandParameter="Configure" Margin="0,0,12,8"/></WrapPanel>
  </StackPanel>
  <Border Visibility="{Binding HasPlan,Converter={StaticResource BoolVisibility}}" Background="{DynamicResource Surface}" BorderBrush="{DynamicResource Border}" BorderThickness="1" Padding="16" Margin="0,16,0,0" CornerRadius="8">
   <StackPanel><TextBlock Text="{Binding L[IntegrationReviewChanges]}" Style="{StaticResource SectionTitle}"/><TextBlock Text="{Binding L[IntegrationPlanHint]}" Style="{StaticResource SecondaryText}" Margin="0,8,0,12"/><TextBox Text="{Binding PlanText,Mode=OneWay}" IsReadOnly="True" TextWrapping="Wrap" MaxHeight="240" VerticalScrollBarVisibility="Auto" Style="{StaticResource TechnicalText}"/>
   <WrapPanel Margin="0,12,0,0"><Button Content="{Binding L[IntegrationApply]}" Command="{Binding ApplyCommand}" IsEnabled="{Binding CanApply}" Style="{StaticResource PrimaryButton}" Margin="0,0,12,0"/><Button Content="{Binding L[Cancel]}" Command="{Binding CancelPlanCommand}"/></WrapPanel></StackPanel>
  </Border>
  <TextBlock Text="{Binding ReceiptText}" Style="{StaticResource SecondaryText}" Margin="0,12,0,0"/>
  <Expander Header="{Binding L[IntegrationDiagnostics]}" Margin="0,24,0,0" AutomationProperties.AutomationId="IntegrationEvents">
   <StackPanel Margin="0,12,0,0"><TextBlock Text="{Binding L[IntegrationMetadataOnly]}" Style="{StaticResource SecondaryText}" Margin="0,0,0,8"/><TextBox Text="{Binding EventText,Mode=OneWay}" IsReadOnly="True" TextWrapping="Wrap" MaxHeight="280" VerticalScrollBarVisibility="Auto" Style="{StaticResource TechnicalText}" AutomationProperties.Name="{Binding L[IntegrationDiagnostics]}"/></StackPanel>
  </Expander>
  <Expander Header="{Binding L[ProductApprovals]}" Margin="0,20,0,0" Foreground="{DynamicResource TextPrimary}"><StackPanel>
  <CheckBox Content="{Binding L[IntegrationHardwareAuto]}" IsChecked="{Binding HardwareAuto}" Margin="0,20,0,8"/>
  <TextBlock Text="{Binding L[IntegrationHardwareAutoHint]}" Style="{StaticResource SecondaryText}"/></StackPanel></Expander>
 </StackPanel>
</UserControl>
