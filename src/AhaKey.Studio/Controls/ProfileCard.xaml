<UserControl x:Class="AhaKey.Studio.Controls.ProfileCard" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="clr-namespace:AhaKey.Studio.Controls">
 <Button Command="{Binding DataContext.Profiles.SelectCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}" HorizontalContentAlignment="Stretch" Padding="20,16" AutomationProperties.Name="{Binding AccessibleName}">
  <Button.Style><Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}"><Style.Triggers><DataTrigger Binding="{Binding Selected}" Value="True"><Setter Property="Background" Value="{DynamicResource ProfileSelection}"/><Setter Property="BorderBrush" Value="{DynamicResource Accent}"/></DataTrigger></Style.Triggers></Style></Button.Style>
  <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
   <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
    <Border Width="36" Height="36" Background="{DynamicResource IconSurface}" CornerRadius="8" Margin="0,0,12,0"><local:NavigationIcon Kind="{Binding IconKind}" Width="23" Height="23" Stroke="{DynamicResource TextPrimary}"/></Border>
    <TextBlock Grid.Column="1" Text="{Binding Name}" Style="{StaticResource CardTitle}" VerticalAlignment="Center" Margin="0,0,8,0"/>
    <Border Grid.Column="2" Background="{DynamicResource Selection}" CornerRadius="6" Padding="8,3" VerticalAlignment="Center" Visibility="{Binding Selected, Converter={StaticResource BoolVisibility}}"><TextBlock Text="{Binding L[ProductEditing]}" Style="{StaticResource Caption}" Foreground="{DynamicResource Focus}"/></Border>
   </Grid>
   <TextBlock Grid.Row="1" Text="{Binding Description}" Style="{StaticResource Secondary}" Margin="0,12,0,12" MinHeight="20"/>
   <Grid Grid.Row="2" Margin="0,0,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="{Binding L[CardSummary]}" Style="{StaticResource Caption}"/><TextBlock Text="{Binding L[PhysicalLocalOnly]}" Style="{StaticResource Caption}" Foreground="{DynamicResource Warning}" Visibility="{Binding IsDirty, Converter={StaticResource BoolVisibility}}"/></StackPanel><StackPanel Grid.Column="1" Orientation="Horizontal" Margin="12,0,0,0"><local:NavigationIcon Kind="Keymap" Width="14" Height="14" Stroke="{DynamicResource TextSecondary}"/><local:NavigationIcon Kind="Display" Width="14" Height="14" Margin="8,0,0,0" Stroke="{DynamicResource TextSecondary}"/><local:NavigationIcon Kind="Lighting" Width="14" Height="14" Margin="8,0,0,0" Stroke="{DynamicResource TextSecondary}"/></StackPanel></Grid>
  </Grid>
 </Button>
</UserControl>