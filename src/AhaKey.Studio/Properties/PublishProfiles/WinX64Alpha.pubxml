<Project>
 <PropertyGroup>
  <Configuration>Release</Configuration><RuntimeIdentifier>win-x64</RuntimeIdentifier><SelfContained>true</SelfContained>
  <PublishSingleFile>false</PublishSingleFile><PublishTrimmed>false</PublishTrimmed><DebugType>none</DebugType>
  <PublishDir>$(MSBuildProjectDirectory)\..\..\artifacts\runtime\</PublishDir>
 </PropertyGroup>
</Project>
