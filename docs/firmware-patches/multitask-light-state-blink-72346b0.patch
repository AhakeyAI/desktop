+/* Caller supplies a 600ms cycle in its native tick units. Rendering never
+ * changes task presence/state, OLED selection, timeouts or host activity. */
+uint8_t display_presentation_slot_led_visible(uint8_t slot, uint32_t now_ticks, uint32_t cycle_ticks)
+{
+    uint8_t bit;
+    uint32_t elapsed;
+    if (slot >= DISPLAY_PRESENTATION_SLOT_COUNT ||
+        s_display_presentation.mode != DISPLAY_PRESENTATION_MODE_MULTI ||
+        !s_display_presentation.multi_valid || !s_display_presentation.multi_slots[slot].valid)
+        return 0;
+    bit = (uint8_t) (1U << slot);
+    if (!(s_display_presentation.led_blink_active & bit))
+        return 1;
+    if (cycle_ticks < 12 || cycle_ticks > UINT32_MAX / 5U) {
+        s_display_presentation.led_blink_active &= (uint8_t) ~bit;
+        s_display_presentation.led_blink_pending &= (uint8_t) ~bit;
+        return 1;
+    }
+    if (s_display_presentation.led_blink_pending & bit) {
+        s_display_presentation.led_blink_started[slot] = now_ticks;
+        s_display_presentation.led_blink_pending &= (uint8_t) ~bit;
+    }
+    /* Unsigned subtraction also handles the native 32-bit clock wrapping. */
+    elapsed = (uint32_t) (now_ticks - s_display_presentation.led_blink_started[slot]);
+    if (elapsed >= cycle_ticks * 3U) {
+        s_display_presentation.led_blink_active &= (uint8_t) ~bit;
+        return 1;
+    }
+    return (elapsed % cycle_ticks) < (cycle_ticks * 5U / 12U);
+}
