+++ b/tests/host/ai_presentation/run_task_led_blink.py
@@ -0,0 +1,71 @@
+"""Host-run exact production LED renderer + display service, no hardware writes."""
+from pathlib import Path
+import re, subprocess, tempfile, sys
+ROOT = Path(__file__).resolve().parents[3]
+main = (ROOT/'APP/sub_main/main.c').read_text()
+start = main.index('void task_render_multi_leds(void)')
+brace = main.index('{',start)
+depth=1; end=brace+1
+while depth:
+    depth += (main[end]=='{')-(main[end]=='}'); end+=1
+renderer=main[start:end]
+if '--baseline' not in sys.argv:
+    assert 'display_presentation_slot_led_visible(slot, now_ticks, MS1_TO_SYSTEM_TIME(600))' in renderer
+    assert 'TMOS_GetSystemClock()' in renderer
+source=r'''
+#include <stdint.h>
+#include <stdio.h>
+#include "display_presentation.h"
+#define TASK_SLOT_COUNT 4
+#define MS1_TO_SYSTEM_TIME(x) (((uint32_t)(x) * 1000u) / 625u)
+static uint32_t clock_ticks;
+#define TMOS_GetSystemClock() (clock_ticks)
+static struct { uint32_t hex; } ws2812_list[8];
+#define CHECK(x) do { if (!(x)) {fprintf(stderr,"FAIL line %d: %s\n",__LINE__,#x); return 1;} } while(0)
+'''+renderer+r'''
+int main(void) {
+    uint8_t p[14]={0x99,1,1,1,0,1,2,0,1,3,0,0,0,0};
+    display_presentation_init();
+    CHECK(display_presentation_set_mode(1));
+    CHECK(display_presentation_apply_multi_snapshot(p,14,0)==0);
+    clock_ticks=10000; task_render_multi_leds();
+    CHECK(ws2812_list[0].hex==0x8000A000u && ws2812_list[2].hex==0x80A0A000u && ws2812_list[4].hex==0x80A00000u);
+    CHECK(ws2812_list[6].hex==0 && ws2812_list[7].hex==0);
+    clock_ticks=10000+MS1_TO_SYSTEM_TIME(300); task_render_multi_leds();
+    CHECK(ws2812_list[0].hex==0 && ws2812_list[2].hex==0 && ws2812_list[4].hex==0);
+    CHECK(display_presentation_select().selected && display_presentation_select().slot==1 && display_presentation_select().state==2); /* OLED still selects waiting task */
+    CHECK(display_presentation_active_mask()==7);
+    CHECK(display_presentation_apply_multi_snapshot(p,14,0)==0);
+    p[4]=1; CHECK(display_presentation_apply_multi_snapshot(p,14,0)==0); /* foreground only */
+    CHECK(display_presentation_set_mode(1)); /* repeated mode ACK must not restart */
+    task_render_multi_leds(); CHECK(ws2812_list[0].hex==0);
+    clock_ticks=10000+MS1_TO_SYSTEM_TIME(600);task_render_multi_leds();CHECK(ws2812_list[0].hex!=0);
+    clock_ticks=10000+MS1_TO_SYSTEM_TIME(900);task_render_multi_leds();CHECK(ws2812_list[0].hex==0);
+    clock_ticks=10000+MS1_TO_SYSTEM_TIME(1200);task_render_multi_leds();CHECK(ws2812_list[0].hex!=0);
+    clock_ticks=10000+MS1_TO_SYSTEM_TIME(1500);task_render_multi_leds();CHECK(ws2812_list[0].hex==0);
+    clock_ticks=10000+MS1_TO_SYSTEM_TIME(1800);task_render_multi_leds();CHECK(ws2812_list[0].hex!=0);
+    p[6]=1;CHECK(display_presentation_apply_multi_snapshot(p,14,0)==0); /* slot1 waiting -> running */
+    task_render_multi_leds(); clock_ticks+=MS1_TO_SYSTEM_TIME(300);task_render_multi_leds();
+    CHECK(ws2812_list[0].hex!=0 && ws2812_list[2].hex==0 && ws2812_list[4].hex!=0);
+    p[0]=0x99;p[6]=9;CHECK(display_presentation_apply_multi_snapshot(p,14,0)!=0);
+    task_render_multi_leds();CHECK(ws2812_list[2].hex==0);p[6]=1;
+    p[2]=0;CHECK(display_presentation_apply_multi_snapshot(p,14,0)==0);task_render_multi_leds();CHECK(ws2812_list[0].hex==0);
+    display_presentation_clear_for_quiet_sleep();task_render_multi_leds();
+    for(int i=0;i<8;i++)CHECK(ws2812_list[i].hex==0);
+    p[2]=1;CHECK(display_presentation_apply_multi_snapshot(p,14,0)==0);
+    clock_ticks=UINT32_MAX-200;task_render_multi_leds();
+    clock_ticks+=MS1_TO_SYSTEM_TIME(300);task_render_multi_leds();CHECK(ws2812_list[0].hex==0);
+    CHECK(display_presentation_set_mode(0));CHECK(display_presentation_set_mode(1));task_render_multi_leds();CHECK(display_presentation_active_mask()==0);
+    CHECK(display_presentation_apply_multi_snapshot(p,14,0)==0);task_render_multi_leds();
+    for(int i=0;i<300;i++)display_presentation_tick_one_second();
+    task_render_multi_leds();for(int i=0;i<8;i++)CHECK(ws2812_list[i].hex==0);
+    CHECK(display_presentation_apply_multi_snapshot(p,14,0)==0);task_render_multi_leds();
+    clock_ticks+=MS1_TO_SYSTEM_TIME(300);task_render_multi_leds();CHECK(ws2812_list[0].hex==0);
+    puts("PASS: exact production renderer and task LED state-change blink");return 0;
+}
+'''
+with tempfile.TemporaryDirectory(prefix='ahakey-task-led-host-') as tmp:
+    path=Path(tmp)/'test.c';path.write_text(source)
+    exe=Path(tmp)/'test'
+    subprocess.run(['clang','-std=c99','-Wall','-Wextra','-Werror','-fsanitize=address,undefined','-I',str(ROOT/'APP/services'),str(path),str(ROOT/'APP/services/display_presentation.c'),'-o',str(exe)],check=True)
+    subprocess.run([str(exe)],check=True)
