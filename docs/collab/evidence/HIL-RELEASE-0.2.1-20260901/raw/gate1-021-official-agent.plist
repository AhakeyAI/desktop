<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>KeepAlive</key>
	<true/>
	<key>Label</key>
	<string>lab.jawa.ahakeyconfig.agent</string>
	<key>MachServices</key>
	<dict>
		<key>lab.jawa.ahakeyconfig.runtime</key>
		<true/>
	</dict>
	<key>ProgramArguments</key>
	<array>
		<string>/Applications/AhaKey Studio.app/Contents/MacOS/ahakeyconfig-agent</string>
		<string>--socket</string>
		<string>/Users/heartline/Library/Application Support/AhaKeyConfig/ahakey.sock</string>
	</array>
	<key>RunAtLoad</key>
	<true/>
	<key>StandardErrorPath</key>
	<string>/Users/heartline/Library/Logs/ahakeyconfig-agent.log</string>
	<key>StandardOutPath</key>
	<string>/Users/heartline/Library/Logs/ahakeyconfig-agent.log</string>
</dict>
</plist>
