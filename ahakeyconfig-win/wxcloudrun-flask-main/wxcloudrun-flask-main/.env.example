# 复制为 .env 后按需修改（.env 已在 .gitignore 中忽略）

# Flask
FLASK_DEBUG=1

# MySQL
MYSQL_USERNAME=root
MYSQL_PASSWORD=1234
MYSQL_ADDRESS=127.0.0.1:3306
MYSQL_DATABASE=vibe_keyboard
MYSQL_AUTO_CREATE_DATABASE=1

# JWT / 管理员
JWT_SECRET=local-dev-change-me
JWT_EXPIRES_SECONDS=604800
ADMIN_PHONES=13800138000

# 方舟推理
ARK_API_KEY=
ARK_MODEL_ID=
ARK_BASE_URL=https://ark.cn-beijing.volces.com/api/v3

# 兑换码与配额
COUPON_CODE_PEPPER=change-me-coupon-pepper
FREE_COUPON_DAYS=60
COUPON_REDEEM_WINDOW_MINUTES=10
COUPON_REDEEM_MAX_FAILS=5
COUPON_REDEEM_LOCKOUT_MINUTES=15

# 微信 Native 支付
# WECHAT_PAY_APPID=
# WECHAT_PAY_MCHID=
# WECHAT_PAY_SERIAL_NO=
# WECHAT_PAY_PRIVATE_KEY_PATH=E:/path/to/apiclient_key.pem
# WECHAT_PAY_NOTIFY_URL=https://your-domain/api/v1/payment/wechat/notify
# WECHAT_PAY_API_V3_KEY=32-char-api-v3-key

# 键盘配置工具发布信息（用于客户端检查更新）
# CONFIG_TOOL_LATEST_VERSION=1.0.2
# CONFIG_TOOL_DOWNLOAD_URL=https://your-domain/static/VibecodingKeyboard_Setup.exe
# CONFIG_TOOL_RELEASE_NOTES=1. 修复若干问题\n2. 优化连接稳定性
