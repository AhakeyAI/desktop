# 本地打包/公证配置（复制为 build.local.env 并填入真实值；该文件已 gitignore，勿提交）。
#
# 签名：如果钥匙串里有多张证书，可用 SIGNING_IDENTITY_HINT 过滤；
# 或者直接写死 SIGNING_IDENTITY。
export SIGNING_IDENTITY='Developer ID Application: Your Name (XXXXXXXXXX)'
# export SIGNING_IDENTITY_HINT='XXXXXXXXXX'

# 公证方式 A：使用已存到钥匙串的 notarytool profile（推荐）
# export NOTARY_PROFILE='your-notary-profile'
#
# 公证方式 B：直接在环境变量里传入（CI 方便，但不建议提交到仓库）
# export NOTARY_APPLE_ID='your-apple-id@example.com'
# export NOTARY_TEAM_ID='XXXXXXXXXX'
# export NOTARY_PASSWORD='xxxx-xxxx-xxxx-xxxx'
