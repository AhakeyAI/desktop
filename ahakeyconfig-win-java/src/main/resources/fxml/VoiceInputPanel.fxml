<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.example.ahakey.app.VoiceInputController">
    <padding>
        <Insets top="8" right="8" bottom="8" left="8"/>
    </padding>
    <spacing>8</spacing>
    
    <HBox fx:id="voiceControlBox" spacing="8" alignment="CENTER_LEFT">
        <Button fx:id="voiceToggleButton" text="语音输入" minWidth="80" />
        <Label fx:id="statusLabel" text="语音输入已就绪" style="-fx-text-fill: #666; -fx-font-size: 12px;" />
    </HBox>
    
    <Label fx:id="resultPreview" text="" style="-fx-font-size: 13px; -fx-text-fill: #333; -fx-wrap-text: true;" />
</VBox>